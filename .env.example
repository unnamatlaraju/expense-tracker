# Copy this file to `.env` and fill in real values.
# `.env` is gitignored, so secrets never get committed.

# --- Database ---
# Local Docker (docker-compose.yml, runs on 5433 so it never clashes with an
# existing Postgres on 5432):
DATABASE_URL="postgresql://spendly:spendly@localhost:5433/spendly?schema=public"
DIRECT_URL="postgresql://spendly:spendly@localhost:5433/spendly?schema=public"

# Supabase example (two ports: 6543 pooled for the app, 5432 direct for migrations):
#   DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Percent-encode special characters in the password: @ -> %40, $ -> %24, : -> %3A, / -> %2F

# --- Auth ---
# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

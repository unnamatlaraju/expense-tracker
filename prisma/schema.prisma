// Spendly database schema.
//   npx prisma migrate dev --name <name>   # create + apply a migration
//   npx prisma migrate deploy              # apply pending migrations
//   npx prisma studio                      # browse the data

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations use the direct (non-pooled) connection.
  directUrl = env("DIRECT_URL")
}

enum Frequency {
  weekly
  monthly
  yearly
}

/// What kind of recurring outflow this is. Purely a label — "emi" does not
/// imply the loan maths from the loans feature.
enum CommitmentKind {
  bill
  emi
  subscription
  other
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // IANA timezone (e.g. "Asia/Kolkata"). Used to work out the user's local
  // "today" so dates and reminders aren't computed in the server's timezone.
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now())

  expenses    Expense[]
  categories  Category[]
  budgets     Budget[]
  commitments Commitment[]
  loans       Loan[]
}

model Expense {
  id                 String     @id @default(cuid())
  userId             String
  description        String
  // Money is stored as a fixed-precision decimal, never a float.
  amount             Decimal    @db.Decimal(12, 2)
  category           String
  date               DateTime   @db.Date
  isRecurring        Boolean    @default(false)
  recurringFrequency Frequency?
  // Set when this expense was generated by processing a commitment. Together
  // with `periodStart` the unique constraint makes "process" idempotent: a given
  // period can only ever be logged once, even if the button is double-clicked.
  commitmentId       String?
  periodStart        DateTime?  @db.Date
  createdAt          DateTime   @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  commitment Commitment? @relation(fields: [commitmentId], references: [id], onDelete: SetNull)

  @@unique([commitmentId, periodStart])
  @@index([userId, date])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  // Lower-cased copy of `name` so uniqueness is case-insensitive *at the
  // database level* (an app-level check alone has a race window).
  nameLower String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nameLower])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  category  String
  limit     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

/// A recurring outflow: a bill, EMI, subscription or anything else you pay on a
/// schedule. `nextDue` always points at the next unpaid period.
model Commitment {
  id               String         @id @default(cuid())
  userId           String
  description      String
  amount           Decimal        @db.Decimal(12, 2)
  category         String
  frequency        Frequency
  kind             CommitmentKind @default(other)
  nextDue          DateTime       @db.Date
  isActive         Boolean        @default(true)
  // Reminder preferences. Stored and editable now; delivery is a later step.
  remindersEnabled Boolean        @default(true)
  remindDaysBefore Int            @default(3)
  // Optional last active day (e.g. a 12-month plan). Past it the commitment
  // auto-pauses rather than nagging forever.
  endDate          DateTime?      @db.Date
  autopay          Boolean        @default(false)
  notes            String?
  createdAt        DateTime       @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedExpenses Expense[]

  @@index([userId])
  // The table keeps its original name so this rename moves no data.
  @@map("RecurringExpense")
}

/// A loan repaid in equal monthly instalments.
///
/// Only the *terms* are stored. The amortisation schedule, the interest split,
/// the payoff date and the prepayment comparison are all derived from these
/// numbers by `lib/loans.ts` at render time, so there is no second copy of the
/// maths to drift out of step with what the user typed.
model Loan {
  id           String   @id @default(cuid())
  userId       String
  name         String
  lender       String?
  principal    Decimal  @db.Decimal(12, 2)
  /// Nominal annual interest rate as a percentage, e.g. 9.5 for 9.5% p.a.
  annualRate   Decimal  @db.Decimal(5, 2)
  /// Number of monthly instalments.
  tenureMonths Int
  /// Due date of the first instalment; the rest follow month by month.
  firstDue     DateTime @db.Date
  notes        String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Fixed-window rate limiter. One row per key (e.g. "login:203.0.113.5").
model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  windowEnd DateTime

  @@index([windowEnd])
}

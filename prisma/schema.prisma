// Spendly database schema.
//   npx prisma db push      # apply to the database
//   npx prisma studio       # browse the data

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations/schema pushes use the direct (session) connection.
  directUrl = env("DIRECT_URL")
}

enum Frequency {
  weekly
  monthly
  yearly
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // IANA timezone (e.g. "Asia/Kolkata"). Used to work out the user's local
  // "today" so dates and reminders aren't computed in the server's timezone.
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now())

  expenses   Expense[]
  categories Category[]
  budgets    Budget[]
  recurring  RecurringExpense[]
}

model Expense {
  id                 String     @id @default(cuid())
  userId             String
  description        String
  // Money is stored as a fixed-precision decimal, never a float.
  amount             Decimal    @db.Decimal(12, 2)
  category           String
  date               DateTime   @db.Date
  isRecurring        Boolean    @default(false)
  recurringFrequency Frequency?
  // Set when this expense was generated by processing a commitment. Together
  // with `periodStart` the unique constraint makes "process" idempotent: a given
  // period can only ever be logged once, even if the button is double-clicked.
  commitmentId       String?
  periodStart        DateTime?  @db.Date
  createdAt          DateTime   @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  commitment RecurringExpense? @relation(fields: [commitmentId], references: [id], onDelete: SetNull)

  @@unique([commitmentId, periodStart])
  @@index([userId, date])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  // Lower-cased copy of `name` so uniqueness is case-insensitive *at the
  // database level* (an app-level check alone has a race window).
  nameLower String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nameLower])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  category  String
  limit     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model RecurringExpense {
  id          String    @id @default(cuid())
  userId      String
  description String
  amount      Decimal   @db.Decimal(12, 2)
  category    String
  frequency   Frequency
  nextDue     DateTime  @db.Date
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedExpenses Expense[]

  @@index([userId])
}

// Fixed-window rate limiter. One row per key (e.g. "login:203.0.113.5").
model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  windowEnd DateTime

  @@index([windowEnd])
}
